DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# From Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your-temporary-or-permanent-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Any string you make up - enter this SAME value in the Meta Dashboard
# webhook verification field.
WHATSAPP_VERIFY_TOKEN=pick-a-secret-string
